<mvc:View
  controllerName="shoppingtool.controller.App"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns:mvc="sap.ui.core.mvc">
  <Shell appWidthLimited="false">
    <App>
      <f:DynamicPage
        id="shoppingPage"
        fitContent="false">
        <f:title>
          <f:DynamicPageTitle>
            <f:heading>
              <Title
                text="Shoppingtool"
                level="H1" />
            </f:heading>
            <f:expandedContent>
              <Text text="Einkaufsliste mit vorbereiteter Produkterkennung" />
            </f:expandedContent>
            <f:snappedContent>
              <ObjectStatus
                text="{= ${/items}.length + ' Artikel' }"
                state="Information" />
            </f:snappedContent>
          </f:DynamicPageTitle>
        </f:title>

        <f:header>
          <f:DynamicPageHeader pinnable="false">
            <VBox class="sapUiResponsiveContentPadding shoppingContent">
              <Label
                text="Produkte"
                labelFor="productInput" />
              <TextArea
                id="productInput"
                value="{/inputText}"
                placeholder="z.B. buttermann, 2 Milch, Tomaten"
                rows="3"
                growing="true"
                growingMaxLines="5"
                width="100%" />
              <Toolbar design="Transparent" class="inputActions">
                <ToolbarSpacer />
                <Button
                  text="Erkennen"
                  icon="sap-icon://sys-find"
                  type="Emphasized"
                  press=".onRecognize" />
              </Toolbar>
            </VBox>
          </f:DynamicPageHeader>
        </f:header>

        <f:content>
          <VBox class="sapUiResponsiveContentPadding shoppingContent">
            <MessageStrip
              text="Noch keine Artikel erkannt. Gib deine Einkaufsliste ein und starte die Erkennung."
              type="Information"
              showIcon="true"
              visible="{= ${/items}.length === 0 }"
              class="sapUiSmallMarginBottom" />

            <List
              id="shoppingList"
              items="{/items}"
              noDataText="Keine Artikel in der Liste">
              <headerToolbar>
                <Toolbar>
                  <Title
                    text="Einkaufsliste"
                    level="H2" />
                  <ToolbarSpacer />
                  <ObjectStatus
                    text="{= ${/items}.length + ' Artikel' }"
                    state="Information" />
                  <Button
                    text="Optimieren"
                    icon="sap-icon://simulate"
                    type="Emphasized"
                    press=".onOptimizeShopping" />
                </Toolbar>
              </headerToolbar>
              <CustomListItem
                highlight="{= ${purchased} ? 'Success' : 'None' }"
                highlightText="{= ${purchased} ? 'Erledigt' : '' }">
                <HBox
                  alignItems="Start"
                  class="shoppingItemShell">
                  <CheckBox
                    selected="{purchased}"
                    class="shoppingItemCheck" />
                  <VBox class="itemRow">
                    <HBox
                      alignItems="Center"
                      justifyContent="SpaceBetween"
                      class="sapUiTinyMarginBottom">
                      <Text text="{= ${purchased} ? 'Erledigt' : 'Offen' }" />
                      <Text
                        text="{= ${rawText} ? 'Aus: ' + ${rawText} : '' }"
                        class="mutedText rawText" />
                    </HBox>

                    <HBox
                      class="itemEditRow"
                      renderType="Bare">
                      <Input
                        value="{name}"
                        placeholder="Produkt"
                        width="100%"
                        change=".onListItemChanged" />
                      <StepInput
                        value="{quantity}"
                        min="1"
                        width="7rem"
                        change=".onListItemChanged" />
                      <Select
                        selectedKey="{unit}"
                        width="6.5rem"
                        change=".onListItemChanged">
                        <core:Item key="Stk" text="Stk" />
                        <core:Item key="g" text="g" />
                        <core:Item key="kg" text="kg" />
                        <core:Item key="ml" text="ml" />
                        <core:Item key="l" text="l" />
                      </Select>
                    </HBox>

                    <Toolbar
                      class="itemActions"
                      design="Transparent">
                      <ToolbarSpacer />
                      <Button
                        text="Löschen"
                        type="Transparent"
                        press=".onDeleteItem" />
                    </Toolbar>
                  </VBox>
                </HBox>
              </CustomListItem>
            </List>

            <Panel
              headerText="Aktuelle Angebote"
              class="sapUiSmallMarginTop">
              <VBox>
                <HBox
                  alignItems="Center"
                  justifyContent="SpaceBetween"
                  class="sapUiTinyMarginBottom">
                  <ObjectStatus
                    text="{= ${offers>/status} === 'loading' ? 'Angebote werden geladen' : ${offers>/status} === 'ready' ? ${offers>/offers}.length + ' aktuelle Angebote geladen' : ${offers>/status} === 'empty' ? 'Keine aktuellen Angebote verfügbar' : 'Angebote konnten nicht geladen werden' }"
                    state="{= ${offers>/status} === 'ready' ? 'Success' : ${offers>/status} === 'error' ? 'Error' : 'Information' }" />
                  <Button
                    text="{= ${offers>/status} === 'error' ? 'Erneut laden' : 'Aktualisieren' }"
                    icon="sap-icon://refresh"
                    enabled="{= !${offers>/loading} }"
                    press=".onRefreshOffers" />
                </HBox>
                <MessageStrip
                  text="Die aktuell gültigen Angebotsdaten werden geladen."
                  type="Information"
                  showIcon="true"
                  visible="{offers>/loading}" />
                <MessageStrip
                  text="{offers>/errorMessage}"
                  type="Error"
                  showIcon="true"
                  visible="{= ${offers>/status} === 'error' }" />
                <MessageStrip
                  text="Keine aktuellen, unbedingten Angebote veröffentlicht. Bitte den neuesten optimizer-ready Snapshot bereitstellen und erneut laden."
                  type="Warning"
                  showIcon="true"
                  visible="{= ${offers>/status} === 'empty' }" />
                <MessageStrip
                  text="TESTDATEN aus einem UI-Fixture – keine echten oder aktuellen Angebote."
                  type="Warning"
                  showIcon="true"
                  visible="{offers>/isDemo}" />
                <Text
                  text="{= ${offers>/status} === 'ready' ? ${offers>/excludedCount} + ' abgelaufene, ungültige, unbekannte oder bedingte Angebote ausgeschlossen.' : '' }"
                  visible="{= ${offers>/status} === 'ready' &amp;&amp; ${offers>/excludedCount} > 0 }"
                  class="mutedText" />
              </VBox>
            </Panel>

            <Panel
              headerText="Preisoptimierung mit aktuellen Angeboten"
              visible="{/optimizationResult/hasResult}"
              class="sapUiSmallMarginTop">
              <VBox>
                <HBox
                  alignItems="Center"
                  justifyContent="SpaceBetween"
                  class="sapUiTinyMarginBottom">
                  <Title
                    text="{= ${/optimizationResult/bestStore/storeName} || 'Kein Laden mit passenden aktuellen Angeboten' }"
                    level="H3" />
                  <ObjectNumber
                    number="{/optimizationResult/bestStore/totalPrice}"
                    unit="EUR"
                    state="Information" />
                </HBox>
                <Text
                  text="Angebotssumme nur für die abgedeckten Artikel; kein vollständiger Regalpreis-Warenkorb."
                  class="mutedText sapUiTinyMarginBottom" />
                <ObjectStatus
                  text="{= ${/optimizationResult/bestStore/coveredItemCount} + ' von ' + ${/optimizationResult/bestStore/requestedItemCount} Listenartikeln abgedeckt' }"
                  state="{= ${/optimizationResult/bestStore/isComplete} ? 'Success' : 'Warning' }"
                  class="sapUiSmallMarginBottom" />
                <List
                  items="{/optimizationResult/bestStore/matchedItems}"
                  noDataText="Keine passenden Angebote">
                  <StandardListItem
                    title="{name}"
                    description="{= ${packages} + ' x ' + ${offerName} }"
                    info="{= ${totalPrice} + ' EUR' }"
                    infoState="Success" />
                </List>
                <List
                  items="{/optimizationResult/bestStore/missingItems}"
                  noDataText="Alle Listenartikel sind abgedeckt">
                  <StandardListItem
                    title="{name}"
                    description="{coverageMessage}"
                    info="Nicht abgedeckt"
                    infoState="Warning" />
                </List>
                <Toolbar
                  design="Transparent"
                  class="sapUiSmallMarginTop">
                  <Title
                    text="Split-Empfehlung"
                    level="H3" />
                  <ToolbarSpacer />
                  <ObjectNumber
                    number="{/optimizationResult/splitPlan/totalPrice}"
                    unit="EUR"
                    state="Information" />
                </Toolbar>
                <Text
                  text="Angebotssumme nur für die abgedeckten Artikel; kein vollständiger Regalpreis-Warenkorb."
                  class="mutedText sapUiTinyMarginBottom" />
                <ObjectStatus
                  text="{= ${/optimizationResult/splitPlan/coveredItemCount} + ' von ' + ${/optimizationResult/splitPlan/requestedItemCount} Listenartikeln abgedeckt' }"
                  state="{= ${/optimizationResult/splitPlan/isComplete} ? 'Success' : 'Warning' }"
                  class="sapUiTinyMarginBottom" />
                <ObjectStatus
                  text="{= ${/optimizationResult/splitPlan/hasComparableCoverage} ? ${/optimizationResult/splitPlan/storeCount} + ' Laden/Läden, Ersparnis nur für gleiche Abdeckung: ' + ${/optimizationResult/splitPlan/savingsComparedToBestStore} + ' EUR; Zusatzladen-Abzug ' + ${/optimizationResult/splitPlan/totalExtraStorePenalty} + ' EUR, effektiv ' + ${/optimizationResult/splitPlan/effectiveSavings} + ' EUR' : 'Keine Ersparnis berechnet: Einzelladen und Split decken unterschiedliche Artikel ab.' }"
                  state="{= ${/optimizationResult/splitPlan/isWorthwhile} ? 'Success' : 'Information' }"
                  class="sapUiSmallMarginBottom" />
                <MessageStrip
                  text="{= ${/optimizationResult/splitPlan/isWorthwhile} ? 'Empfehlung: Split lohnt sich nach Zusatzladen-Abzug auf gleicher Artikelabdeckung.' : ${/optimizationResult/splitPlan/hasComparableCoverage} ? 'Empfehlung: Ein Laden reicht; der Split spart nach Zusatzladen-Abzug nicht genug.' : 'Die Teilsummen sind nicht vergleichbar, weil unterschiedlich viele Artikel abgedeckt werden.' }"
                  type="{= ${/optimizationResult/splitPlan/isWorthwhile} ? 'Success' : 'Information' }"
                  showIcon="true"
                  class="sapUiSmallMarginBottom" />
                <List
                  items="{/optimizationResult/splitPlan/missingItems}"
                  noDataText="Alle Listenartikel sind abgedeckt">
                  <StandardListItem
                    title="{name}"
                    description="{coverageMessage}"
                    info="Nicht abgedeckt"
                    infoState="Warning" />
                </List>
                <List
                  items="{/optimizationResult/splitPlan/stores}"
                  noDataText="Keine Split-Angebote">
                  <StandardListItem
                    title="{storeName}"
                    description="{= ${matchedItems}.length + ' Artikel' }"
                    info="{= ${totalPrice} + ' EUR' }"
                    infoState="Information" />
                </List>
              </VBox>
            </Panel>
          </VBox>
        </f:content>
      </f:DynamicPage>
    </App>
  </Shell>
</mvc:View>
