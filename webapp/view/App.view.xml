<mvc:View
  controllerName="shoppingtool.controller.App"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:mvc="sap.ui.core.mvc">
  <Shell appWidthLimited="false">
    <App>
      <Page
        title="Shoppingtool"
        class="shoppingPage">
        <content>
          <VBox class="sapUiResponsiveContentPadding shoppingContent">
            <Panel
              headerText="Einkauf erfassen"
              expandable="false"
              class="sapUiSmallMarginBottom">
              <content>
                <VBox>
                  <Label
                    text="Produkte"
                    labelFor="productInput" />
                  <TextArea
                    id="productInput"
                    value="{/inputText}"
                    placeholder="z.B. buttermann, 2 Milch, Tomaten"
                    rows="3"
                    growing="true"
                    growingMaxLines="5"
                    width="100%" />
                  <Toolbar design="Transparent">
                    <ToolbarSpacer />
                    <Button
                      text="Erkennen"
                      type="Emphasized"
                      press=".onRecognize" />
                  </Toolbar>
                </VBox>
              </content>
            </Panel>

            <MessageStrip
              text="Noch keine Artikel erkannt. Gib deine Einkaufsliste ein und starte die Erkennung."
              type="Information"
              showIcon="true"
              visible="{= ${/items}.length === 0 }"
              class="sapUiSmallMarginBottom" />

            <List
              id="shoppingList"
              items="{/items}"
              noDataText="Keine Artikel in der Liste">
              <headerToolbar>
                <Toolbar>
                  <Title
                    text="Erkannte Artikel"
                    level="H2" />
                  <ToolbarSpacer />
                  <ObjectStatus
                    text="{= ${/items}.length + ' Artikel' }"
                    state="Information" />
                </Toolbar>
              </headerToolbar>
              <CustomListItem>
                <VBox class="itemRow">
                  <HBox
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    class="sapUiTinyMarginBottom">
                    <ObjectStatus
                      text="{= ${status} === 'confirmed' ? 'Bestätigt' : 'Vorschlag' }"
                      state="{= ${status} === 'confirmed' ? 'Success' : 'Warning' }" />
                    <Text
                      text="{= ${rawText} ? 'Aus: ' + ${rawText} : '' }"
                      class="mutedText rawText" />
                  </HBox>

                  <HBox
                    class="itemEditRow"
                    renderType="Bare">
                    <Input
                      value="{name}"
                      placeholder="Produkt"
                      width="100%" />
                    <StepInput
                      value="{quantity}"
                      min="1"
                      width="7rem" />
                    <Select
                      selectedKey="{unit}"
                      width="6.5rem">
                      <core:Item key="Stk" text="Stk" />
                      <core:Item key="g" text="g" />
                      <core:Item key="kg" text="kg" />
                      <core:Item key="ml" text="ml" />
                      <core:Item key="l" text="l" />
                    </Select>
                  </HBox>

                  <Toolbar
                    class="itemActions"
                    design="Transparent">
                    <ToolbarSpacer />
                    <Button
                      text="Bestätigen"
                      type="Accept"
                      visible="{= ${status} !== 'confirmed' }"
                      press=".onConfirmItem" />
                    <Button
                      text="Löschen"
                      type="Transparent"
                      press=".onDeleteItem" />
                  </Toolbar>
                </VBox>
              </CustomListItem>
            </List>
          </VBox>
        </content>
      </Page>
    </App>
  </Shell>
</mvc:View>
