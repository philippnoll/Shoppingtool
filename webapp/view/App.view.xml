<mvc:View
  controllerName="shoppingtool.controller.App"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns:mvc="sap.ui.core.mvc">
  <Shell appWidthLimited="false">
    <App>
      <f:DynamicPage
        id="shoppingPage"
        fitContent="false">
        <f:title>
          <f:DynamicPageTitle>
            <f:heading>
              <Title
                text="Shoppingtool"
                level="H1" />
            </f:heading>
            <f:expandedContent>
              <Text text="Einkaufsliste mit vorbereiteter Produkterkennung" />
            </f:expandedContent>
            <f:snappedContent>
              <ObjectStatus
                text="{= ${/items}.length + ' Artikel' }"
                state="Information" />
            </f:snappedContent>
          </f:DynamicPageTitle>
        </f:title>

        <f:header>
          <f:DynamicPageHeader pinnable="false">
            <VBox class="sapUiResponsiveContentPadding shoppingContent">
              <Label
                text="Einzelprodukt suchen"
                labelFor="quickProductInput" />
              <HBox class="quickInputRow">
                <Input
                  id="quickProductInput"
                  value="{/quickProductText}"
                  placeholder="z.B. Butter"
                  showSuggestion="true"
                  filterSuggests="false"
                  suggestionItems="{/productSuggestions}"
                  suggest=".onSuggestProduct"
                  suggestionItemSelected=".onProductSuggestionSelected"
                  submit=".onAppendQuickProduct"
                  width="100%">
                  <suggestionItems>
                    <core:Item
                      key="{key}"
                      text="{name}" />
                  </suggestionItems>
                </Input>
                <Button
                  text="Zur Eingabe"
                  icon="sap-icon://add"
                  press=".onAppendQuickProduct" />
              </HBox>

              <Label
                text="Produkte"
                labelFor="productInput" />
              <TextArea
                id="productInput"
                value="{/inputText}"
                placeholder="z.B. buttermann, 2 Milch, Tomaten"
                rows="3"
                growing="true"
                growingMaxLines="5"
                width="100%" />
              <Toolbar design="Transparent" class="inputActions">
                <ToolbarSpacer />
                <Button
                  text="Erkennen"
                  icon="sap-icon://sys-find"
                  type="Emphasized"
                  press=".onRecognize" />
              </Toolbar>
            </VBox>
          </f:DynamicPageHeader>
        </f:header>

        <f:content>
          <VBox class="sapUiResponsiveContentPadding shoppingContent">
            <MessageStrip
              text="Noch keine Artikel erkannt. Gib deine Einkaufsliste ein und starte die Erkennung."
              type="Information"
              showIcon="true"
              visible="{= ${/items}.length === 0 }"
              class="sapUiSmallMarginBottom" />

            <List
              id="shoppingList"
              items="{/items}"
              noDataText="Keine Artikel in der Liste">
              <headerToolbar>
                <Toolbar>
                  <Title
                    text="Einkaufsliste"
                    level="H2" />
                  <ToolbarSpacer />
                  <ObjectStatus
                    text="{= ${/items}.length + ' Artikel' }"
                    state="Information" />
                  <Button
                    text="Optimieren"
                    icon="sap-icon://simulate"
                    type="Emphasized"
                    press=".onOptimizeShopping" />
                </Toolbar>
              </headerToolbar>
              <CustomListItem
                highlight="{= ${purchased} ? 'Success' : 'None' }"
                highlightText="{= ${purchased} ? 'Erledigt' : '' }">
                <HBox
                  alignItems="Start"
                  class="shoppingItemShell">
                  <CheckBox
                    selected="{purchased}"
                    class="shoppingItemCheck" />
                  <VBox class="itemRow">
                    <HBox
                      alignItems="Center"
                      justifyContent="SpaceBetween"
                      class="sapUiTinyMarginBottom">
                      <Text text="{= ${purchased} ? 'Erledigt' : 'Offen' }" />
                      <Text
                        text="{= ${rawText} ? 'Aus: ' + ${rawText} : '' }"
                        class="mutedText rawText" />
                    </HBox>

                    <HBox
                      class="itemEditRow"
                      renderType="Bare">
                      <Input
                        value="{name}"
                        placeholder="Produkt"
                        width="100%" />
                      <StepInput
                        value="{quantity}"
                        min="1"
                        width="7rem" />
                      <Select
                        selectedKey="{unit}"
                        width="6.5rem">
                        <core:Item key="Stk" text="Stk" />
                        <core:Item key="g" text="g" />
                        <core:Item key="kg" text="kg" />
                        <core:Item key="ml" text="ml" />
                        <core:Item key="l" text="l" />
                      </Select>
                    </HBox>

                    <Toolbar
                      class="itemActions"
                      design="Transparent">
                      <ToolbarSpacer />
                      <Button
                        text="Löschen"
                        type="Transparent"
                        press=".onDeleteItem" />
                    </Toolbar>
                  </VBox>
                </HBox>
              </CustomListItem>
            </List>

            <Panel
              headerText="Preisoptimierung"
              visible="{/optimizationResult/hasResult}"
              class="sapUiSmallMarginTop">
              <VBox>
                <HBox
                  alignItems="Center"
                  justifyContent="SpaceBetween"
                  class="sapUiTinyMarginBottom">
                  <Title
                    text="{/optimizationResult/bestStore/storeName}"
                    level="H3" />
                  <ObjectNumber
                    number="{/optimizationResult/bestStore/totalPrice}"
                    unit="EUR"
                    state="Success" />
                </HBox>
                <ObjectStatus
                  text="{= ${/optimizationResult/bestStore/missingItems}.length === 0 ? 'Alle Artikel gefunden' : ${/optimizationResult/bestStore/missingItems}.length + ' Artikel fehlen' }"
                  state="{= ${/optimizationResult/bestStore/missingItems}.length === 0 ? 'Success' : 'Warning' }"
                  class="sapUiSmallMarginBottom" />
                <List
                  items="{/optimizationResult/bestStore/matchedItems}"
                  noDataText="Keine passenden Angebote">
                  <StandardListItem
                    title="{name}"
                    description="{= ${packages} + ' x ' + ${offerName} }"
                    info="{= ${totalPrice} + ' EUR' }"
                    infoState="Success" />
                </List>
                <Toolbar
                  design="Transparent"
                  class="sapUiSmallMarginTop">
                  <Title
                    text="Split-Empfehlung"
                    level="H3" />
                  <ToolbarSpacer />
                  <ObjectNumber
                    number="{/optimizationResult/splitPlan/totalPrice}"
                    unit="EUR"
                    state="{= ${/optimizationResult/splitPlan/isWorthwhile} ? 'Success' : 'Warning' }" />
                </Toolbar>
                <ObjectStatus
                  text="{= ${/optimizationResult/splitPlan/storeCount} + ' Laden/Läden, Preisersparnis ' + ${/optimizationResult/splitPlan/savingsComparedToBestStore} + ' EUR, Zusatzladen-Abzug ' + ${/optimizationResult/splitPlan/totalExtraStorePenalty} + ' EUR, effektiv ' + ${/optimizationResult/splitPlan/effectiveSavings} + ' EUR' }"
                  state="{= ${/optimizationResult/splitPlan/isWorthwhile} ? 'Success' : 'Warning' }"
                  class="sapUiSmallMarginBottom" />
                <List
                  items="{/optimizationResult/splitPlan/stores}"
                  noDataText="Keine Split-Angebote">
                  <StandardListItem
                    title="{storeName}"
                    description="{= ${matchedItems}.length + ' Artikel' }"
                    info="{= ${totalPrice} + ' EUR' }"
                    infoState="Information" />
                </List>
              </VBox>
            </Panel>
          </VBox>
        </f:content>
      </f:DynamicPage>
    </App>
  </Shell>
</mvc:View>
