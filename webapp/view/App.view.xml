<mvc:View
  controllerName="shoppingtool.controller.App"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns:mvc="sap.ui.core.mvc">
  <Shell appWidthLimited="false">
    <App>
      <f:DynamicPage
        id="shoppingPage"
        fitContent="false">
        <f:title>
          <f:DynamicPageTitle>
            <f:heading>
              <Title
                text="Shoppingtool"
                level="H1" />
            </f:heading>
            <f:expandedContent>
              <Text text="Einkaufsliste mit vorbereiteter Produkterkennung" />
            </f:expandedContent>
            <f:snappedContent>
              <ObjectStatus
                text="{= ${/items}.length + ' Artikel' }"
                state="Information" />
            </f:snappedContent>
          </f:DynamicPageTitle>
        </f:title>

        <f:header>
          <f:DynamicPageHeader pinnable="false">
            <VBox class="sapUiResponsiveContentPadding shoppingContent">
              <Label
                text="Produkte"
                labelFor="productInput" />
              <TextArea
                id="productInput"
                value="{/inputText}"
                placeholder="z.B. buttermann, 2 Milch, Tomaten"
                rows="3"
                growing="true"
                growingMaxLines="5"
                width="100%" />
              <Toolbar design="Transparent" class="inputActions">
                <ToolbarSpacer />
                <Button
                  text="Erkennen"
                  icon="sap-icon://sys-find"
                  type="Emphasized"
                  press=".onRecognize" />
              </Toolbar>
            </VBox>
          </f:DynamicPageHeader>
        </f:header>

        <f:content>
          <VBox class="sapUiResponsiveContentPadding shoppingContent">
            <MessageStrip
              text="Noch keine Artikel erkannt. Gib deine Einkaufsliste ein und starte die Erkennung."
              type="Information"
              showIcon="true"
              visible="{= ${/items}.length === 0 }"
              class="sapUiSmallMarginBottom" />

            <List
              id="shoppingList"
              items="{/items}"
              noDataText="Keine Artikel in der Liste">
              <headerToolbar>
                <Toolbar>
                  <Title
                    text="Erkannte Artikel"
                    level="H2" />
                  <ToolbarSpacer />
                  <ObjectStatus
                    text="{= ${/items}.length + ' Artikel' }"
                    state="Information" />
                </Toolbar>
              </headerToolbar>
              <CustomListItem>
                <VBox class="itemRow">
                  <HBox
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    class="sapUiTinyMarginBottom">
                    <ObjectStatus
                      text="{= ${status} === 'confirmed' ? 'Bestätigt' : 'Vorschlag' }"
                      state="{= ${status} === 'confirmed' ? 'Success' : 'Warning' }" />
                    <Text
                      text="{= ${rawText} ? 'Aus: ' + ${rawText} : '' }"
                      class="mutedText rawText" />
                  </HBox>

                  <HBox
                    class="itemEditRow"
                    renderType="Bare">
                    <Input
                      value="{name}"
                      placeholder="Produkt"
                      width="100%" />
                    <StepInput
                      value="{quantity}"
                      min="1"
                      width="7rem" />
                    <Select
                      selectedKey="{unit}"
                      width="6.5rem">
                      <core:Item key="Stk" text="Stk" />
                      <core:Item key="g" text="g" />
                      <core:Item key="kg" text="kg" />
                      <core:Item key="ml" text="ml" />
                      <core:Item key="l" text="l" />
                    </Select>
                  </HBox>

                  <Toolbar
                    class="itemActions"
                    design="Transparent">
                    <ToolbarSpacer />
                    <Button
                      text="Bestätigen"
                      type="Accept"
                      visible="{= ${status} !== 'confirmed' }"
                      press=".onConfirmItem" />
                    <Button
                      text="Löschen"
                      type="Transparent"
                      press=".onDeleteItem" />
                  </Toolbar>
                </VBox>
              </CustomListItem>
            </List>
          </VBox>
        </f:content>
      </f:DynamicPage>
    </App>
  </Shell>
</mvc:View>
